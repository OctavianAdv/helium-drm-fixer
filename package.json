{
  "name": "helium-drm",
  "version": "1.0.0",
  "module": "cli.ts",
  "type": "module",
  "bin": {
    "fix-helium-drm": "./cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build cli.ts --compile --outfile ./dist/fix-helium-drm",
    "build:windows": "bun build cli.ts --compile --target=bun-windows-x64 --outfile ./dist/fix-helium-drm-windows-x64.exe",
    "build:linux": "bun build cli.ts --compile --target=bun-linux-x64 --outfile ./dist/fix-helium-drm-linux-x64",
    "build:linux-arm64": "bun build cli.ts --compile --target=bun-linux-arm64 --outfile ./dist/fix-helium-drm-linux-arm64",
    "build:all": "bun run build:windows && bun run build:linux && bun run build:linux-arm64"
  },
  "private": true,
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "7zip-bin": "5.1.1",
    "@agent-infra/browser-finder": "^0.2.1",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "ora": "^9.0.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.22.4"
  }
}
